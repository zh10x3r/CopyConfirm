#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
101 ICON "CopyConfirm.ico"
1 RT_MANIFEST "CopyConfirm.manifest"

IDD_POPUP_SETTINGS DIALOGEX 0, 0, 245, 130
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_POPUP_GAP_LABEL, 12, 15, 154, 12
  EDITTEXT IDC_POPUP_GAP, 173, 12, 60, 14, ES_NUMBER | ES_AUTOHSCROLL
  CONTROL "", IDC_POPUP_GAP_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 224, 12, 9, 14
  LTEXT "", IDC_POPUP_GAP_HELP, 12, 31, 221, 21
  LTEXT "", IDC_POPUP_DURATION_LABEL, 12, 59, 154, 12
  EDITTEXT IDC_POPUP_DURATION, 173, 56, 60, 14, ES_AUTOHSCROLL
  CONTROL "", IDC_POPUP_DURATION_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS, 224, 56, 9, 14
  LTEXT "", IDC_POPUP_STATUS, 12, 80, 221, 21
  PUSHBUTTON "", IDC_POPUP_PREVIEW, 12, 104, 49, 15
  PUSHBUTTON "", IDC_POPUP_RESTORE, 66, 104, 69, 15
  DEFPUSHBUTTON "", IDOK, 140, 104, 44, 15
  PUSHBUTTON "", IDCANCEL, 189, 104, 44, 15
END

1 VERSIONINFO
FILEVERSION 1,2,6,0
PRODUCTVERSION 1,2,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "复制确认\0"
      VALUE "FileVersion", "1.2.6\0"
      VALUE "InternalName", "CopyConfirm\0"
      VALUE "OriginalFilename", "CopyConfirm.exe\0"
      VALUE "ProductName", "复制确认\0"
      VALUE "ProductVersion", "1.2.6\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
